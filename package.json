{
  "name": "express-pro-boilerplate",
  "version": "1.0.0",
  "description": "Industry-Standard Express.js Boilerplate",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.js\"",
    "prepare": "husky"
